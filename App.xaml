<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:NexTap.Converters"
             x:Class="NexTap.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:CoverToColorConverter x:Key="CoverToColorConverter" />
            <conv:CoverToNameConverter x:Key="CoverToNameConverter" />
            <conv:CoverEqualsConverter x:Key="CoverEqualsConverter" />
            <conv:CoverToTextColorConverter x:Key="CoverToTextColorConverter" />
            <conv:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
