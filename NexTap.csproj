<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>NexTap</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>NexTap</ApplicationTitle>
		<ApplicationId>com.kenan.nextap</ApplicationId>
		<ApplicationIdGuid>2C8B4E2E-6E2A-4C7B-9B8E-8F6D9C6E1A11</ApplicationIdGuid>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!--
			Force the traditional runtime-inflation InitializeComponent() codegen
			path in BOTH Debug and Release, instead of letting SourceGen kick in
			(default is normally Runtime on Debug / XamlC on Release - something
			in this environment is triggering SourceGen instead, and its
			generated __XamlGeneratedCode__ shadow classes aren't getting wired
			to our actual partial classes). Runtime inflation is the long-
			standing, well-tested mechanism and produces a real partial class
			matching x:Class, which is what every InitializeComponent() call in
			this project actually expects.
		-->
		<MauiXamlInflator>Runtime</MauiXamlInflator>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Required explicitly since .NET 8 - UseMaui no longer implies this
			package reference (see build warning MA002). Version pinned to the
			installed Microsoft.Maui.Sdk pack version - bump this alongside the
			MAUI workload if you update it later.
		-->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />

		<!--
			AddDebug() in MauiProgram.cs needs this explicitly - confirmed via
			the actual csc.exe reference list that it wasn't being pulled in
			transitively, unlike its Microsoft.Extensions.* siblings (all
			resolved to 10.0.0 in the same build).
		-->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#EDEDF0" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#EDEDF0" BaseSize="180,180" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Raw Assets (Directory) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>