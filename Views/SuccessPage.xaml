<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NexTap.ViewModels"
             xmlns:controls="clr-namespace:NexTap.Controls"
             x:Class="NexTap.Views.SuccessPage"
             x:DataType="vm:SuccessViewModel">

    <Grid RowDefinitions="*,Auto" Padding="24,20,24,28" RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="28">
            <controls:CheckmarkView x:Name="Checkmark" />
            <VerticalStackLayout Spacing="4">
                <Label Text="Success!" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />
                <Label Text="{Binding CardName}" Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center" FontSize="16" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Button Grid.Row="1" Text="BACK" Style="{StaticResource PrimaryButton}"
                Command="{Binding BackCommand}" />

    </Grid>
</ContentPage>
